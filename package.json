{
  "name": "speaker-visualizer",
  "version": "1.0.0",
  "description": "Visualize what you speak through this process",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.speaker.visualizer",
    "productName": "Speaker Visualizer",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "directories": {
      "output": "dist"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mashedheaven/Speaker-Visualizer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mashedheaven/Speaker-Visualizer/issues"
  },
  "homepage": "https://github.com/mashedheaven/Speaker-Visualizer#readme",
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  }
}
